# User config, runtime state, caches and reports never belong in the repo.
# At runtime they live in ~/.claude/bytek/; these patterns guard against
# copies ending up in a checkout by accident.
/config/
/state/
/cache/
/reports/
/backup/
/coverage/
# Bundler's gems and settings for the coverage tools (Gemfile)
/vendor/
/.bundle/
*.local
*.local.*

# Working notes and plans (people and agents keep them next to the code, never commit them)
/.plan/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
