#!/usr/bin/env bash
# Bytek: a tiny ASCII companion for the Claude Code status line.
#
#   bytek render                     status line entry point (status line JSON on stdin)
#   bytek set <state> [arg] [opts]   write a state by hand (testing, demos)
#        --status TEXT    main status text instead of the state's default
#        --progress N/M   progress for states that show a bar
#        --session ID     session to write (default: "default")
#   bytek states                     list available states
#   bytek hook                       Claude Code hook entry point (hook JSON on stdin)
#   bytek setup [--hooks]            make Bytek the status line (backs up settings.json);
#                                    --hooks also adds the hooks (installs without the plugin)
#   bytek uninstall                  put back the original status line, remove Bytek's hooks
#   bytek help                       this text
#
# Bash 3.2 compatible (the macOS default): no associative arrays, no mapfile.
# The render path reads only local files and must stay well under 50 ms.
# Hooks, setup and uninstall use jq; hooks without it fall back to the event name only.

export LC_ALL="${BYTEK_LOCALE:-en_US.UTF-8}"

# Resolved through symlinks: ~/.claude/bytek/current points at the installed copy.
BYTEK_ROOT="${BYTEK_ROOT:-$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
BYTEK_HOME="${BYTEK_HOME:-$HOME/.claude/bytek}"
BYTEK_SETTINGS="${BYTEK_SETTINGS:-$HOME/.claude/settings.json}"
SLEEP_AFTER="${BYTEK_SLEEP_AFTER:-600}" # seconds of inactivity before Bytek falls asleep
ANTENNA="♡"
SPINNER="◜|◝|◞|◟"
# Bash commands that count as running tests (extended regex, override with BYTEK_TEST_PATTERN).
TEST_RE=${BYTEK_TEST_PATTERN:-'(^|[;&|(]|[[:space:]])(npm (run )?test|npm t|yarn (run )?test|pnpm (run )?test|bun test|npx (jest|vitest|mocha)|jest|vitest|mocha|pytest|python3? -m (pytest|unittest)|(vendor/bin/)?(phpunit|pest)|go test|cargo test|mvn.* (test|verify)|(\./)?gradlew? test|rspec|mix test|dotnet test|node --test|deno test|make (test|check)|[^[:space:]]*tests?/[^[:space:]]*\.sh)'}

die() { printf 'bytek: %s\n' "$1" >&2; exit 1; }

# Splits a "a|b|c" frame list and sets REPLY to the element for tick $2.
# Leading spaces inside a frame are kept (used for bouncing marks).
pick() {
  local IFS='|' n
  set -f
  local frames=($1)
  set +f
  n=${#frames[@]}
  if [ "$n" -eq 0 ]; then REPLY=""; return; fi
  REPLY=${frames[$(( $2 % n ))]}
}

# Reads "key: value" lines from a face file into F_frames, F_thought, F_status, F_detail.
load_face() {
  F_frames="" F_thought="" F_status="" F_detail=""
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key=${line%%:*}
    val=${line#*:}
    val=${val# }
    case "$key" in
      frames|thought|status|detail) printf -v "F_$key" '%s' "$val" ;;
    esac
  done < "$1"
}

# State file fields (one "key=value" per line), loaded into S_<key>:
#   state, arg (fills {arg}), status / detail (override the face's text),
#   progress (N/M), since (last event), turn_start, edits, files ("|a|b|").
STATE_KEYS="state arg status detail progress since turn_start edits files"

load_state() {
  S_state="idle" S_arg="" S_status="" S_detail="" S_progress="" S_since=""
  S_turn_start="" S_edits="" S_files=""
  [ -f "$1" ] || return 0
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    key=${line%%=*}
    val=${line#*=}
    case " $STATE_KEYS " in
      *" $key "*) printf -v "S_$key" '%s' "$val" ;;
    esac
  done < "$1"
}

# Writes all S_<key> fields to $1 atomically (temp file + rename).
write_state() {
  local dir=${1%/*} tmp key val
  mkdir -p "$dir" || return 1
  tmp=$(mktemp "$dir/.tmp.XXXXXX") || return 1
  for key in $STATE_KEYS; do
    eval "val=\$S_$key"
    printf '%s=%s\n' "$key" "${val//$'\n'/ }"
  done > "$tmp" && mv "$tmp" "$1"
}

# Sets REPLY to a 5-cell bar: "▰▰▰▱▱ 3/5" for N/M, or a sweeping cell when unknown.
progress_bar() {
  local n=${1%/*} m=${1#*/} filled i bar=""
  if [[ "$1" =~ ^[0-9]+/[0-9]+$ ]] && [ "$m" -gt 0 ]; then
    filled=$(( n * 5 / m ))
    for i in 0 1 2 3 4; do
      if [ "$i" -lt "$filled" ]; then bar="$bar▰"; else bar="$bar▱"; fi
    done
    REPLY="$bar $n/$m"
  else
    for i in 0 1 2 3 4; do
      if [ "$i" -eq $(( $2 % 5 )) ]; then bar="$bar▰"; else bar="$bar▱"; fi
    done
    REPLY="$bar"
  fi
}

# Sets REPLY to $1 cut to $2 characters, ending in "…" when cut.
truncate_to() {
  if [ -z "$2" ] || [ "${#1}" -le "$2" ]; then REPLY=$1; return; fi
  if [ "$2" -le 1 ]; then REPLY=""; return; fi
  REPLY="${1:0:$(( $2 - 1 ))}…"
}

render() {
  local json=$1 session="default" now tick state_file face status detail thought max re
  re='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]+)"'
  [[ "$json" =~ $re ]] && session=${BASH_REMATCH[1]}

  now=${BYTEK_NOW:-$(date +%s)}
  tick=$now

  state_file="$BYTEK_HOME/state/$session"
  [ -f "$state_file" ] || state_file="$BYTEK_HOME/state/default"
  load_state "$state_file"

  # Idle or finished for long enough: Bytek falls asleep.
  if [ -n "$S_since" ] && { [ "$S_state" = idle ] || [ "$S_state" = done ]; } \
     && [ $(( now - S_since )) -ge "$SLEEP_AFTER" ]; then
    S_state=sleeping S_status="" S_arg="idle for $(( (now - S_since) / 60 ))m"
  fi

  face="$BYTEK_ROOT/faces/$S_state"
  [ -f "$face" ] || face="$BYTEK_ROOT/faces/idle"
  load_face "$face"

  pick "$F_frames" "$tick";  local frame=$REPLY
  pick "$F_thought" "$tick"; thought=$REPLY
  status=${S_status:-$F_status}

  detail=${S_detail:-$F_detail}
  case "$detail" in *'{spin}'*)
    pick "$SPINNER" "$tick"; detail=${detail//\{spin\}/$REPLY} ;;
  esac
  case "$detail" in *'{progress}'*)
    progress_bar "$S_progress" "$tick"; detail=${detail//\{progress\}/$REPLY} ;;
  esac
  detail=${detail//\{arg\}/$S_arg}

  # The bot and its gaps take 10 columns; keep the text inside the terminal.
  if [ -n "$COLUMNS" ] && [ "$COLUMNS" -gt 12 ] 2>/dev/null; then max=$(( COLUMNS - 12 )); fi
  truncate_to "$status" "$max"; status=$REPLY
  truncate_to "$detail" "$max"; detail=$REPLY

  printf '    %s%s\n' "$ANTENNA" "${thought:+ $thought}"
  printf ' ╭──┴──╮\n'
  printf ' │ %s │  %s\n' "$frame" "$status"
  printf ' ╰─┬─┬─╯  \033[2m%s\033[0m\n' "$detail"
}

cmd_render() {
  local json out
  json=$(cat)
  if out=$(render "$json" 2>/dev/null) && [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    printf '[•ᴗ•] bytek\n'
  fi
}

cmd_set() {
  local session="default"
  [ -n "$1" ] || die "usage: bytek set <state> [arg] [--status TEXT] [--progress N/M] [--session ID]"
  [ -f "$BYTEK_ROOT/faces/$1" ] || die "unknown state: $1 (see: bytek states)"
  load_state /dev/null
  S_state=$1
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --status)   S_status=$2; shift 2 ;;
      --progress) S_progress=$2; shift 2 ;;
      --session)  session=$2; shift 2 ;;
      *)          S_arg=$1; shift ;;
    esac
  done
  [[ "$session" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid session id: $session"
  S_since=${BYTEK_NOW:-$(date +%s)}
  write_state "$BYTEK_HOME/state/$session" || die "cannot write to $BYTEK_HOME/state"
}

# Switches to a new state and clears the previous state's text.
# Usage: to <state> [arg] [status] [detail]
to() { S_state=$1 S_arg=$2 S_status=$3 S_detail=$4 S_progress=""; }

# Sets REPLY to "41s" or "3m 12s".
duration() {
  if [ "$1" -lt 60 ]; then REPLY="${1}s"; else REPLY="$(( $1 / 60 ))m $(( $1 % 60 ))s"; fi
}

# Maps one hook event to a state. Never prints anything: stdout from some
# hooks (UserPromptSubmit, SessionStart) would be added to Claude's context.
hook() {
  local json event="" session="" tool="" file="" pattern="" cmd="" message="" ntype="" err="" cwd=""
  local f now n re
  json=$(cat)
  if command -v jq >/dev/null 2>&1; then
    IFS=$'\037' read -r event session tool file pattern cmd message ntype err cwd <<EOF
$(printf '%s' "$json" | jq -r '[
    .hook_event_name, .session_id, .tool_name,
    (.tool_input.file_path // .tool_input.notebook_path),
    .tool_input.pattern, .tool_input.command, .message, .notification_type,
    (.error // (if (.tool_response | type) == "object" then .tool_response.error else null end)),
    .cwd
  ] | map(. // "" | tostring | gsub("[\u001f\n\r\t]"; " ")) | join("\u001f")')
EOF
  else
    re='"hook_event_name"[[:space:]]*:[[:space:]]*"([A-Za-z]+)"'
    [[ "$json" =~ $re ]] && event=${BASH_REMATCH[1]}
    re='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]+)"'
    [[ "$json" =~ $re ]] && session=${BASH_REMATCH[1]}
    re='"tool_name"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_]+)"'
    [[ "$json" =~ $re ]] && tool=${BASH_REMATCH[1]}
  fi
  [ -f "$BYTEK_HOME/debug" ] && printf '%s\n' "$json" >> "$BYTEK_HOME/hooks.log"

  [[ "$session" =~ ^[A-Za-z0-9_-]+$ ]] || session=default
  f="$BYTEK_HOME/state/$session"
  now=${BYTEK_NOW:-$(date +%s)}
  load_state "$f"
  [ -n "$cwd" ] && file=${file#"$cwd"/}

  case "$event" in
    SessionStart)
      to idle
      S_turn_start="" S_edits="" S_files=""
      follow_plugin_update
      find "$BYTEK_HOME/state" -type f -mtime +7 -delete 2>/dev/null ;;
    SessionEnd)
      rm -f "$f"; return 0 ;;
    UserPromptSubmit)
      to thinking
      S_turn_start=$now S_edits=0 S_files="" ;;
    PreToolUse)
      case "$tool" in
        Read)       to reading "$file" ;;
        Grep|Glob)  to searching "$pattern" ;;
        Edit|Write|MultiEdit|NotebookEdit)
          S_edits=$(( ${S_edits:-0} + 1 ))
          case "${S_files:-|}" in *"|$file|"*) ;; *) S_files="${S_files:-|}$file|" ;; esac
          n=${S_files//[!|]/}; n=$(( ${#n} - 1 ))
          if [ "$n" -gt 1 ]; then to editing "$file" "editing $n files"; else to editing "$file"; fi ;;
        Bash)
          if [[ "$cmd" =~ $TEST_RE ]]; then to testing
          else to thinking "" "running a command" "\$ $cmd"; fi ;;
        mcp__*)     n=${tool#mcp__}; to thinking "" "using ${n%%__*}" ;;
        *)          to thinking "" "using $tool" ;;
      esac ;;
    PostToolUse)
      if [ "$S_state" = testing ]; then to thinking "" "tests passed" "✓ tests passed"
      elif [ "$S_state" = waiting ]; then to thinking; fi ;;
    PostToolUseFailure)
      if [ "$S_state" = testing ]; then to error "$err" "tests failed"
      else to error "$err" "$tool failed"; fi ;;
    PermissionRequest)
      to waiting "allow $tool${file:+ $file}${cmd:+ $cmd}?" ;;
    PermissionDenied)
      to thinking ;;
    Notification)
      # "Waiting for your input" after a finished turn is not a question; keep the state.
      case "$ntype$message" in idle_prompt*|*"waiting for your input"*) return 0 ;; esac
      to waiting "$message" ;;
    Stop)
      duration $(( now - ${S_turn_start:-$now} ))
      if [ "${S_edits:-0}" -gt 0 ]; then to done "$S_edits changes · $REPLY"; else to done "$REPLY"; fi ;;
    *)
      return 0 ;;
  esac
  S_since=$now
  write_state "$f"
}

cmd_hook() {
  hook >/dev/null 2>&1
  exit 0
}

# The status line runs ~/.claude/bytek/current/bin/bytek. A plugin update installs into a
# new folder, so when the hook runs from the plugin and `current` points at another plugin
# folder (or nowhere), move it here. A link to a checkout or a manual install is left alone.
follow_plugin_update() {
  local link="$BYTEK_HOME/current" target
  [ -n "$CLAUDE_PLUGIN_ROOT" ] || return 0
  target=$(cd -P "$link" 2>/dev/null && pwd -P)
  if [ -z "$target" ] || { [ "$target" != "$BYTEK_ROOT" ] && case "$target" in */.claude/plugins/*) true ;; *) false ;; esac; }; then
    mkdir -p "$BYTEK_HOME" && ln -sfn "$BYTEK_ROOT" "$link"
  fi
}

# jq test for a status line or hook command that runs Bytek ("…/bin/bytek render", quoted or not).
IS_BYTEK='test("/bin/bytek\"? (render|hook)$")'

cmd_setup() {
  local with_hooks=false bin backup original="$BYTEK_HOME/original-statusline.json" tmp
  [ "$1" = --hooks ] && with_hooks=true
  command -v jq >/dev/null 2>&1 || die "setup needs jq (https://jqlang.org)"
  mkdir -p "$BYTEK_HOME/backup" "$BYTEK_HOME/state" || die "cannot create $BYTEK_HOME"
  ln -sfn "$BYTEK_ROOT" "$BYTEK_HOME/current" || die "cannot link $BYTEK_HOME/current"
  bin="$BYTEK_HOME/current/bin/bytek"

  mkdir -p "$(dirname "$BYTEK_SETTINGS")"
  [ -f "$BYTEK_SETTINGS" ] || printf '{}\n' > "$BYTEK_SETTINGS"
  jq -e 'type == "object"' "$BYTEK_SETTINGS" >/dev/null 2>&1 || die "$BYTEK_SETTINGS is not a JSON object; not touching it"
  backup="$BYTEK_HOME/backup/settings.json.$(date +%Y%m%d-%H%M%S)"
  cp -p "$BYTEK_SETTINGS" "$backup" || die "cannot back up $BYTEK_SETTINGS"

  # Remember the status line Bytek replaces, once, and never Bytek's own.
  if [ ! -f "$original" ]; then
    jq ".statusLine // null | if . != null and ((.command // \"\") | $IS_BYTEK) then null else . end" \
      "$BYTEK_SETTINGS" > "$original" || die "cannot write $original"
  fi

  tmp=$(mktemp "$BYTEK_SETTINGS.XXXXXX") || die "cannot write next to $BYTEK_SETTINGS"
  if jq --arg render "\"$bin\" render" --arg hook "\"$bin\" hook" --argjson with_hooks "$with_hooks" \
       --slurpfile plugin "$BYTEK_ROOT/hooks/hooks.json" "
    .statusLine = {type: \"command\", command: \$render, padding: (.statusLine.padding // 0), refreshInterval: 1}
    | if \$with_hooks then
        (\$plugin[0].hooks | map_values(map(.hooks |= map(.command = \$hook)))) as \$ours
        | .hooks = reduce (\$ours | to_entries[]) as \$e (.hooks // {};
            .[\$e.key] = ((.[\$e.key] // []) | map(select(any(.hooks[]?; (.command // \"\") | $IS_BYTEK) | not))) + \$e.value)
      else . end
  " "$BYTEK_SETTINGS" > "$tmp" && jq -e . "$tmp" >/dev/null; then
    cat "$tmp" > "$BYTEK_SETTINGS"
    rm -f "$tmp"
  else
    rm -f "$tmp"
    die "could not update $BYTEK_SETTINGS (unchanged; backup in $backup)"
  fi

  printf 'Bytek is your status line now.\n'
  printf '  settings backup: %s\n' "$backup"
  if [ "$(cat "$original")" != null ]; then
    printf '  your previous status line is saved in %s and comes back with: bytek uninstall\n' "$original"
  fi
  $with_hooks && printf '  hooks added to %s\n' "$BYTEK_SETTINGS"
  return 0
}

cmd_uninstall() {
  local original="$BYTEK_HOME/original-statusline.json" saved=null backup tmp
  command -v jq >/dev/null 2>&1 || die "uninstall needs jq (https://jqlang.org)"
  [ -f "$BYTEK_SETTINGS" ] || { echo "Nothing to do: no $BYTEK_SETTINGS"; return 0; }
  [ -f "$original" ] && saved=$(cat "$original")
  mkdir -p "$BYTEK_HOME/backup"
  backup="$BYTEK_HOME/backup/settings.json.$(date +%Y%m%d-%H%M%S).before-uninstall"
  cp -p "$BYTEK_SETTINGS" "$backup" || die "cannot back up $BYTEK_SETTINGS"

  # The status line goes back only if it is still Bytek's; one set later by someone else stays.
  tmp=$(mktemp "$BYTEK_SETTINGS.XXXXXX") || die "cannot write next to $BYTEK_SETTINGS"
  if jq --argjson saved "$saved" "
    if ((.statusLine.command // \"\") | $IS_BYTEK) then
      (if \$saved == null then del(.statusLine) else .statusLine = \$saved end)
    else . end
    | if has(\"hooks\") then
        .hooks |= (map_values(map(select(any(.hooks[]?; (.command // \"\") | $IS_BYTEK) | not)))
                   | with_entries(select(.value | length > 0)))
        | if .hooks == {} then del(.hooks) else . end
      else . end
  " "$BYTEK_SETTINGS" > "$tmp" && jq -e . "$tmp" >/dev/null; then
    cat "$tmp" > "$BYTEK_SETTINGS"
    rm -f "$tmp"
  else
    rm -f "$tmp"
    die "could not update $BYTEK_SETTINGS (unchanged)"
  fi
  rm -f "$original" "$BYTEK_HOME/current"
  printf 'Bytek is off. Settings backup: %s\n' "$backup"
  printf 'Your config and state stay in %s (delete it to remove everything).\n' "$BYTEK_HOME"
}

usage() { sed -n '2,14s/^# \{0,1\}//p' "$0"; }

cmd_states() {
  local f
  for f in "$BYTEK_ROOT"/faces/*; do printf '%s\n' "${f##*/}"; done
}

case "${1:-}" in
  render) cmd_render ;;
  set)    shift; cmd_set "$@" ;;
  states) cmd_states ;;
  hook)   cmd_hook ;;
  setup)  shift; cmd_setup "$@" ;;
  uninstall) cmd_uninstall ;;
  help|-h|--help) usage ;;
  *)      usage; exit 1 ;;
esac
