#!/usr/bin/env bash
# Bytek: a tiny ASCII companion for the Claude Code status line.
#
#   bytek render                     status line entry point (status line JSON on stdin)
#   bytek set <state> [arg] [opts]   write a state by hand (testing, demos)
#        --status TEXT    main status text instead of the state's default
#        --progress N/M   progress for states that show a bar
#        --session ID     session to write (default: "default")
#   bytek states                     list available states
#   bytek addon [name]               set the mood antenna; without a name, list them
#   bytek hook                       Claude Code hook entry point (hook JSON on stdin)
#   bytek setup [--hooks]            make Bytek the status line (backs up settings.json);
#                                    --hooks also adds the hooks (installs without the plugin)
#   bytek uninstall                  put back the original status line, remove Bytek's hooks
#   bytek doctor                     check the installation and say what to fix
#   bytek locale                     the locale Bytek uses to count characters
#   bytek help                       this text
#
# Bash 3.2 compatible (the macOS default): no associative arrays, no mapfile.
# The render path reads only local files and must stay well under 50 ms.
# Hooks, setup and uninstall use jq; hooks without it fall back to the event name only.
#
# This file sets up paths and dispatches; the engine lives in lib/*.sh, one module per job,
# and each command loads only the modules it needs.

set +o errexit +o nounset +o pipefail # declared, not inherited (CONTRIBUTING, "Shell options")

# The engine (lib/) sits next to this script, resolved through symlinks: ~/.claude/bytek/current
# points at the installed copy. BYTEK_ROOT is where the data (faces/) is; tests may move it.
BYTEK_LIB="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/lib"
BYTEK_ROOT="${BYTEK_ROOT:-${BYTEK_LIB%/lib}}"
BYTEK_HOME="${BYTEK_HOME:-$HOME/.claude/bytek}"
BYTEK_SETTINGS="${BYTEK_SETTINGS:-$HOME/.claude/settings.json}"

# shellcheck source=lib/locale.sh
. "$BYTEK_LIB/locale.sh"
locale_pick

die() {
  printf 'bytek: %s\n' "$1" >&2
  exit 1
}

cmd_render() {
  local json out
  json=$(cat)
  if out=$(render_line "$json" 2>/dev/null) && [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    printf '[•ᴗ•] bytek\n'
  fi
}

cmd_set() {
  local session="default"
  [ -n "$1" ] || die "usage: bytek set <state> [arg] [--status TEXT] [--progress N/M] [--session ID]"
  [ -f "$BYTEK_ROOT/faces/$1" ] || die "unknown state: $1 (see: bytek states)"
  state_load /dev/null
  S_state=$1
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --status)
        S_status=$2
        shift 2
        ;;
      --progress)
        S_progress=$2
        shift 2
        ;;
      --session)
        session=$2
        shift 2
        ;;
      *)
        S_arg=$1
        shift
        ;;
    esac
  done
  [[ "$session" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid session id: $session"
  clock_now
  S_since=$REPLY
  state_write "$BYTEK_HOME/state/$session" || die "cannot write to $BYTEK_HOME/state"
}

cmd_hook() {
  hooks_handle >/dev/null 2>&1
  exit 0
}

cmd_states() {
  local f
  for f in "$BYTEK_ROOT"/faces/*; do printf '%s\n' "${f##*/}"; done
}

usage() { sed -n '2,17s/^# \{0,1\}//p' "$0"; }

case "${1:-}" in
  render)
    # shellcheck source=lib/clock.sh
    . "$BYTEK_LIB/clock.sh"
    # shellcheck source=lib/state.sh
    . "$BYTEK_LIB/state.sh"
    # shellcheck source=lib/addon.sh
    . "$BYTEK_LIB/addon.sh"
    # shellcheck source=lib/render.sh
    . "$BYTEK_LIB/render.sh"
    cmd_render
    ;;
  addon)
    shift
    # shellcheck source=lib/addon.sh
    . "$BYTEK_LIB/addon.sh"
    addon_set "$1"
    ;;
  set)
    shift
    # shellcheck source=lib/clock.sh
    . "$BYTEK_LIB/clock.sh"
    # shellcheck source=lib/state.sh
    . "$BYTEK_LIB/state.sh"
    cmd_set "$@"
    ;;
  states) cmd_states ;;
  hook)
    # shellcheck source=lib/clock.sh
    . "$BYTEK_LIB/clock.sh"
    # shellcheck source=lib/state.sh
    . "$BYTEK_LIB/state.sh"
    # shellcheck source=lib/hooks.sh
    . "$BYTEK_LIB/hooks.sh"
    cmd_hook
    ;;
  doctor)
    # shellcheck source=lib/clock.sh
    . "$BYTEK_LIB/clock.sh"
    # shellcheck source=lib/settings.sh
    . "$BYTEK_LIB/settings.sh"
    # shellcheck source=lib/routines.sh
    . "$BYTEK_LIB/routines.sh"
    # shellcheck source=lib/doctor.sh
    . "$BYTEK_LIB/doctor.sh"
    doctor_run || exit 1
    ;;
  setup | uninstall)
    # shellcheck source=lib/clock.sh
    . "$BYTEK_LIB/clock.sh"
    # shellcheck source=lib/settings.sh
    . "$BYTEK_LIB/settings.sh"
    if [ "$1" = setup ]; then
      shift
      settings_setup "$@"
    else
      settings_uninstall
    fi
    ;;
  locale) printf '%s (utf8=%s)\n' "$LC_ALL" "$BYTEK_UTF8" ;;
  help | -h | --help) usage ;;
  *)
    usage
    exit 1
    ;;
esac
