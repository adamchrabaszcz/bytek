# https://editorconfig.org — shared editor settings for every contributor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for a line break.
[*.md]
trim_trailing_whitespace = false

# Written by `git submodule`, which indents with tabs.
[.gitmodules]
indent_style = tab

# shfmt (https://github.com/mvdan/sh) reads these: bash (bats for the tests), with case
# branches indented one level; indentation comes from indent_size above.
# (A pattern with a "/" is anchored to this folder as a whole, so bin/bytek gets its own section.)
[*.{sh,bash}]
shell_variant = bash
switch_case_indent = true

[bin/bytek]
shell_variant = bash
switch_case_indent = true

[*.bats]
shell_variant = bats
switch_case_indent = true
